{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "address": { "$ref": "#/$defs/Address" },
    "home": { "$ref": "#/$defs/Address" },
    "tags": { "type": "array", "items": { "$ref": "#tag" } },
    "audit": { "$ref": "common.json#/$defs/Timestamps" },
    "contact": {
      "oneOf": [
        { "title": "email", "type": "object", "properties": { "address": { "type": "string" } } },
        { "$ref": "#/$defs/Phone" }
      ]
    },
    "broken": { "$ref": "#/$defs/Missing" },
    "slash": { "$ref": "#/$defs/a~1b" }
  },
  "$defs": {
    "Address": {
      "type": "object",
      "description": "Postal address",
      "required": ["zip"],
      "properties": {
        "zip": { "type": "string", "pattern": "^\\d{3}-\\d{4}$" },
        "city": { "type": "string" }
      }
    },
    "Phone": { "type": "string" },
    "Tag": { "$anchor": "tag", "type": "string" },
    "a/b": { "type": ["string", "null"] }
  }
}
