{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "note": { "type": "string", "description": "Free text" },
    "count": { "type": "integer" },
    "customer": { "$ref": "#/$defs/Customer" },
    "payment": {
      "oneOf": [
        {
          "type": "object",
          "required": ["method", "amount"],
          "properties": { "method": { "const": "card" }, "amount": { "type": "number" } }
        },
        {
          "type": "object",
          "required": ["method", "amount"],
          "properties": { "method": { "const": "cash" }, "amount": { "type": "number" } }
        }
      ]
    },
    "shipping": {
      "anyOf": [
        { "type": "object", "title": "Home", "properties": { "zip": { "type": "string" } } },
        { "type": "object", "title": "Store", "properties": { "store": { "type": "string" } } }
      ]
    }
  },
  "$defs": {
    "Customer": { "type": "object", "properties": { "name": { "type": "string" } } }
  }
}
